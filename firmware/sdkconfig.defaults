CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# два слота под обновление по воздуху; не вышла на связь — загрузчик вернёт прежнюю
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# SuperMini: консоль на USB-C (встроенный USB Serial/JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# PSRAM на SuperMini бывает (FH4R2), бывает нет — работаем в обоих случаях
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=49152
# имена файлов на карте длиннее 8.3
CONFIG_FATFS_LFN_HEAP=y
# приём от модема не останавливается, пока идёт запись во флеш (OTA, NVS): иначе аппаратный буфер UART
# (128 байт) на 460800 переполняется за 3 мс и байты теряются
CONFIG_UART_ISR_IN_IRAM=y
