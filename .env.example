# Устройства при первом запуске (дальше — data/devices.json и сайт): id:токен через запятую.
HBOX_DEVICES=cafe-1:сменить-на-случайный-токен
# Не принимать файлы, если на диске свободно меньше (ГБ); чистка держит +1 ГБ сверху
HBOX_MIN_FREE_GB=3
# Сколько дней хранить готовые файлы
HBOX_RETENTION_DAYS=7
# Пароль сайта /hbox/admin/ (логин admin)
HBOX_ADMIN_PASSWORD=сменить
